# Copy to .env for local development. Never commit .env.
# Everything works with the defaults below: no API keys and no AWS account needed.

# Which LLM backend to use: mock | anthropic | bedrock | openai_compat | ollama
# "mock" is deterministic and offline. Tests and CI use it.
PAPERTRAIL_LLM_PROVIDER=mock

# Optional per-step model overrides. Defaults: anthropic -> claude-haiku-5-5 (extract) and
# claude-opus-5-5 (judge); bedrock -> the same models with the "anthropic." prefix.
# PAPERTRAIL_EXTRACT_MODEL=
# PAPERTRAIL_JUDGE_MODEL=

# provider=anthropic: the Anthropic SDK reads this key itself
# ANTHROPIC_API_KEY=

# provider=bedrock: uses your AWS profile (Part 10). Override the region if a model is missing.
# PAPERTRAIL_BEDROCK_REGION=us-east-1

# provider=openai_compat: any OpenAI-compatible endpoint (e.g. Groq, Together, vLLM)
# PAPERTRAIL_OPENAI_COMPAT_BASE_URL=
# PAPERTRAIL_OPENAI_COMPAT_API_KEY=

# provider=ollama: local models
# PAPERTRAIL_OLLAMA_BASE_URL=http://localhost:11434

# AWS (only after the AWS step; local dev never needs these)
# AWS_PROFILE=portfolio
PAPERTRAIL_AWS_REGION=ap-south-1

# Search: "offline" (default, labelled demo data) or "tavily" (live, free tier at tavily.com)
PAPERTRAIL_SEARCH_PROVIDER=offline
# PAPERTRAIL_TAVILY_API_KEY=

# S3 bucket for uploads and Amazon Transcribe output (created in Part 10)
# PAPERTRAIL_MEDIA_BUCKET=

# Tracing (Part 9)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

PAPERTRAIL_ENV=local
PAPERTRAIL_LOG_LEVEL=INFO
